rules_version = '2';

// Sicherheitsregeln für die Bischofschafts-App.
//
// Grundsatz: Die Datenbank enthält Personendaten einer Kirchengemeinde.
// Lesen darf nur, wer angemeldet UND freigeschaltet wurde. Neue Konten
// starten mit der Rolle `pending` und sehen nichts.
//
// Rollen:
//   bishop              – Bischof
//   counselor1          – 1. Ratgeber
//   counselor2          – 2. Ratgeber
//   executive_secretary – Exekutivsekretär
//   secretary           – Sekretär
//   counselor           – Sammelrolle früherer Versionen (weiterhin gültig)
//   assistant           – Assistenz der Abendmahlsversammlung, Bereiche einzeln
//   ap_editor           – nur der AP-Kalender, mit Schreibrecht
//   ap_viewer           – nur der AP-Kalender, ausschliesslich lesend
//   pending             – wartet auf Freigabe, kein Datenzugriff
//
// Innerhalb der Bischofschaft beschreibt die Rolle die Aufgabe, nicht den
// Rechteumfang: Alle freigeschalteten Rollen arbeiten am selben Datenbestand
// und sehen alles. Die Liste unten muss mit `FULL_ACCESS_ROLES` in
// src/lib/types.ts übereinstimmen.
//
// Eine Ausnahme gibt es: Benutzer und Rollen verwaltet ausschliesslich das
// Administrator-Konto (siehe `isAdmin()`), erkannt an seiner Anmelde-E-Mail.
//
// Die beiden AP-Rollen sind die Ausnahme. Der Aktivitätenplan wird mit den
// Beratern und der Jugendführung geteilt; die haben keine Aufgabe, die
// Einblick in Personendaten rechtfertigt. Sie erreichen deshalb genau zwei
// Sammlungen – `apActivities` und `apMonths` – sowie lesend die
// Einstellungen (für den Namen der Gemeinde in der Kopfzeile). Alles
// Übrige bleibt ihnen verschlossen, und zwar hier und nicht erst in der
// Oberfläche.
//
// **Der Plan selbst ist öffentlich.** `apActivities` und `apMonths` darf
// jeder lesen, auch ohne Anmeldung – das ist die Seite unter `/ap`, die
// den AP's, ihren Eltern und den Beratern geschickt wird, ohne dass sich
// dafür jemand ein Konto einrichten müsste. Ein Aktivitätenplan hängt
// sonst am Anschlagbrett; er trägt Datum, Anlass, Treffpunkt und Vornamen,
// und genau dafür wird er verschickt. Was er nicht trägt – Adressen,
// Geburtsdaten, Berufungen, alles Seelsorgerische –, steht in anderen
// Sammlungen und bleibt verschlossen wie zuvor.
//
// Geschrieben wird darin weiterhin nur mit Rolle (`apWrite()`); die
// Öffentlichkeit sieht den Plan, sie ändert ihn nicht. Auch die Links, unter
// denen der Plan als Kalender abonniert werden kann (`calendarFeeds`),
// bleiben angemeldeten Konten vorbehalten: Ein Link ist die Berechtigung
// und lässt sich einzeln widerrufen – etwas anderes als eine Seite, die
// ohnehin offensteht.
//
// Die dritte Ausnahme ist die **Assistenz** der Abendmahlsversammlung. Die
// Vorbereitung des Sonntags lässt sich abgeben – Ansprachen anfragen, die
// Lieder aussuchen, die Gebete verteilen –, ohne den Einblick abzugeben, den
// «Leitung», «Bekanntmachungen» und «Angelegenheiten» mit sich brächten.
// Welche der drei Bereiche offenstehen, steht am Konto im Feld
// `assistantAreas` (`talks`, `music`, `prayers`); die Rolle allein öffnet
// nichts. Vergeben wird das Feld – wie `role` und `active` – allein vom
// Administrator-Konto, und die Selbst-Update-Regel sperrt es gegen die
// eigene Hand.
//
// Die Assistenz erreicht damit genau: `talks` (mit dem Haken «Ansprachen»),
// `prayers` (mit «Gebet»), die Sonntage in `sacramentMeetings` (alle drei
// brauchen sie) und lesend Team, Mitglieder, Lieder und Einstellungen. In
// `sacramentMeetings` und `members` darf sie nur die Felder anfassen, die zu
// ihrem Bereich gehören – die Bekanntmachungen und die Angelegenheiten eines
// Sonntags bleiben unangetastet, ebenso die Stammdaten eines Mitglieds.
// Alles Übrige – Sitzungen, Pendenzen, Notizen, Berufungen, Putzplan,
// AP-Kalender, Anti Doom – bleibt ihr verschlossen.
//
// Eine Grenze hat das: `sacramentMeetings` ist **ein** Dokument je Sonntag,
// und darin stehen die Bekanntmachungen und die Angelegenheiten neben den
// Liedern. Feldweise lesen können Firestore-Regeln nicht. In der App sieht
// die Assistenz diese beiden Bereiche nirgends, und ändern kann sie daran
// nichts; wer die Datenbank unmittelbar abfragt, bekommt das Dokument
// allerdings ganz. Wo das nicht genügt, müssten die beiden Listen in ein
// eigenes Dokument je Sonntag wandern.
//
// Dazu kommt `calendarFeeds`: die Links, unter denen der Plan als Kalender
// abonniert werden kann. Lesen dürfen sie beide AP-Rollen – wer den Plan
// sieht, darf ihn sich auch in den eigenen Kalender holen. Vergeben und
// widerrufen darf sie nur, wer den Plan auch pflegen darf.
//
// Unabhängig von der Rolle steht der Bereich «Impuls» – der geistige
// Bereich für die AP's (docs/KONZEPT-IMPULS.md). Wer ihn sieht, sagt das
// Feld `impulse` am Benutzer; wer Inhalte pflegen darf, das Feld
// `impulseEditor`. Beide vergibt allein das Administrator-Konto, und das
// Administrator-Konto sieht den Bereich immer. Die Sammlungen des Bereichs
// folgen mit der nächsten Etappe – verriegelt ist ab sofort, dass sich
// niemand die beiden Schalter selbst setzt.

service cloud.firestore {
  match /databases/{database}/documents {

    /* ---------------- Hilfsfunktionen ---------------- */

    function signedIn() {
      return request.auth != null;
    }

    /*
     * Das Administrator-Konto – verwaltet als Einziges Benutzer und Rollen.
     *
     * Erkannt an der Anmelde-E-Mail aus dem Auth-Token, nicht am Profil in
     * der Datenbank: Das Token stammt von Firebase Authentication und lässt
     * sich – anders als ein Profilfeld – nicht vom Client fälschen.
     * Dieselbe Adresse steht in `ADMIN_EMAIL` (src/lib/types.ts).
     */
    function isAdmin() {
      return signedIn() && request.auth.token.email == 'alain.sc2@gmail.com';
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasProfile() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    // Freigeschaltet: Profil vorhanden, aktiv und mit echter Rolle.
    // Wer das erfüllt, hat vollen Zugriff.
    function approved() {
      return hasProfile()
        && userDoc().active == true
        && userDoc().role in [
             'bishop', 'counselor1', 'counselor2',
             'executive_secretary', 'secretary', 'counselor'
           ];
    }

    // Darf den AP-Kalender lesen – Vollzugriff eingeschlossen.
    function apAccess() {
      return hasProfile()
        && userDoc().active == true
        && userDoc().role in [
             'bishop', 'counselor1', 'counselor2',
             'executive_secretary', 'secretary', 'counselor',
             'ap_editor', 'ap_viewer'
           ];
    }

    // Darf im AP-Kalender auch schreiben. `ap_viewer` fehlt hier bewusst.
    function apWrite() {
      return hasProfile()
        && userDoc().active == true
        && userDoc().role in [
             'bishop', 'counselor1', 'counselor2',
             'executive_secretary', 'secretary', 'counselor',
             'ap_editor'
           ];
    }

    /*
     * Assistenz der Abendmahlsversammlung – und welche Bereiche.
     *
     * Die Rolle allein öffnet nichts: Gefragt wird immer nach einem der drei
     * Bereiche («talks», «music», «prayers»), und die Antwort steht in
     * `assistantAreas` am Konto. Eine leere Liste heisst «nichts» – so lässt
     * sich der Zugang entziehen, ohne die Rolle zu ändern.
     *
     * `hasAny` statt `in`: Damit lässt sich in einem Zug fragen, ob
     * **irgendeiner** der genannten Bereiche offensteht – gebraucht bei den
     * Sonntagen, die alle drei Bereiche brauchen.
     */
    function assistantSees(areas) {
      return hasProfile()
        && userDoc().active == true
        && userDoc().role == 'assistant'
        && userDoc().get('assistantAreas', []).hasAny(areas);
    }

    /** Irgendein Bereich der Abendmahlsversammlung steht offen. */
    function assistantAny() {
      return assistantSees(['talks', 'music', 'prayers']);
    }

    /*
     * Darf die Assistenz in diesem Bereich auch **schreiben**?
     *
     * Sehen und Ändern sind hier zwei Fragen: Wer die Lieder aussucht, soll
     * die Ansprachen nachschauen können, ohne sie umzustellen. Welche
     * Sparten offenstehen, sagt `assistantAreas`; welche davon beschreibbar
     * sind, `assistantWrite`.
     *
     * Fehlt `assistantWrite` ganz, gilt jeder offene Bereich als
     * beschreibbar – das ist der Altbestand aus der Zeit vor dieser
     * Unterscheidung, und ein Konto soll nicht dadurch stillgelegt werden,
     * dass die App dazugelernt hat. Eine **leere** Liste heisst dagegen
     * ausdrücklich «nur lesen».
     *
     * Gefragt wird immer nach genau einem Bereich – nur dann sagen die
     * beiden `hasAny` etwas über dieselbe Sparte aus. Dieselbe Regel steht
     * in `assistantWriteOf` (src/lib/types.ts).
     */
    function assistantWrites(areas) {
      return assistantSees(areas)
        && userDoc().get('assistantWrite', userDoc().get('assistantAreas', [])).hasAny(areas);
    }

    /**
     * Welche Felder ein Schreibvorgang überhaupt anfasst.
     *
     * `diff().affectedKeys()` nennt genau die Felder, die sich ändern – beim
     * Anlegen gibt es nichts zu vergleichen, dann zählen alle mitgeschickten.
     * Damit lässt sich sagen: «Du darfst dieses Dokument anfassen, aber nur
     * an diesen Stellen.»
     */
    function touchedKeys() {
      return resource == null
        ? request.resource.data.keys()
        : request.resource.data.diff(resource.data).affectedKeys();
    }

    /*
     * Darf den Bereich «Impuls» sehen.
     *
     * Anders als beim AP-Kalender entscheidet keine Rolle, sondern der
     * Schalter am Konto – er wird pro Person vergeben und ist mit jeder
     * freigeschalteten Rolle kombinierbar. Das Administrator-Konto sieht
     * den Bereich immer, und wer Inhalte pflegt, sieht ihn ebenfalls –
     * eine Redaktion, die ihren eigenen Bereich nicht lesen dürfte, wäre
     * ein Widerspruch. `pending` bleibt draussen, auch wenn ein Feld
     * gesetzt sein sollte.
     */
    function impulseAccess() {
      return isAdmin()
        || (hasProfile()
          && userDoc().active == true
          && userDoc().role in [
               'bishop', 'counselor1', 'counselor2',
               'executive_secretary', 'secretary', 'counselor',
               'ap_editor', 'ap_viewer'
             ]
          && (userDoc().get('impulse', false) == true
              || userDoc().get('impulseEditor', false) == true));
    }

    // Darf im Bereich «Impuls» Inhalte pflegen und moderieren – die
    // Redaktion. Vorerst ist das allein das Administrator-Konto; der
    // zweite Schalter steht bereit, damit die Öffnung später keine
    // Regeländerung mehr braucht.
    function impulseWrite() {
      return isAdmin()
        || (hasProfile()
          && userDoc().active == true
          && userDoc().role in [
               'bishop', 'counselor1', 'counselor2',
               'executive_secretary', 'secretary', 'counselor',
               'ap_editor', 'ap_viewer'
             ]
          && userDoc().get('impulseEditor', false) == true);
    }

    /*
     * Darf Benachrichtigungen bestellen.
     *
     * Jedes freigeschaltete Konto – wer die App überhaupt benutzt, darf
     * sich sagen lassen, wenn es etwas Neues gibt. Was jemand dann
     * tatsächlich bekommt, hängt an seinen Einstellungen und daran, was
     * er ohnehin sehen dürfte: Der Versand schaut für die Traktanden auf
     * den Vollzugriff und für den Impuls auf den Schalter am Konto.
     */
    function notifyAccess() {
      return isAdmin() || apAccess();
    }

    /*
     * Prüft, dass ein Feld durch die Schreiboperation nicht verändert wird.
     *
     * `resource` ist null, wenn das Dokument noch nicht existiert. Firestore
     * wertet bei einem `set()` beide Pfade (create und update) aus, deshalb
     * muss dieser Fall abgefangen werden – sonst bricht die Auswertung mit
     * einem Fehler ab statt sauber `false` zu liefern.
     */
    function unchanged(field) {
      return resource != null
        && (!(field in request.resource.data)
            || request.resource.data[field] == resource.data[field]);
    }


    /* ---------------- Benutzer ---------------- */

    match /users/{userId} {
      // Jeder Angemeldete sieht sein eigenes Profil (um die Rolle zu erfahren),
      // Freigeschaltete sehen das ganze Team (für Zuweisungen und Namen).
      // Die Assistenz liest das Team mit: An einer Ansprache steht, wer sie
      // angefragt hat, und am Sonntag, wer für ihn zuständig ist – ohne die
      // Namen stünde dort «Unbekannt».
      allow get: if signedIn() && (request.auth.uid == userId || approved() || assistantAny());
      allow list: if approved() || assistantAny();

      // Ein neues Konto legt sein eigenes Profil an – zwingend als `pending`.
      // Damit kann sich niemand selbst Rechte geben. Auch die beiden
      // Impuls-Schalter darf es nicht mitbringen: Sie blieben sonst als
      // schlafender Zugang stehen und erwachten mit der Freischaltung.
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.role == 'pending'
        && request.resource.data.active == true
        && !('impulse' in request.resource.data)
        && !('impulseEditor' in request.resource.data)
        && !('assistantAreas' in request.resource.data)
        && !('assistantWrite' in request.resource.data);

      // Das eigene Profil darf jede und jeder pflegen (Name, Verknüpfung,
      // Ansichts-Einstellungen) – aber weder Rolle noch Aktivstatus anfassen,
      // und ebenso wenig die beiden Impuls-Schalter. Das ist die Sperre gegen
      // die Selbstfreischaltung, und sie gilt für wartende wie für
      // freigeschaltete Konten gleichermassen.
      allow update: if signedIn()
        && request.auth.uid == userId
        && unchanged('role')
        && unchanged('active')
        && unchanged('impulse')
        && unchanged('impulseEditor')
        && unchanged('assistantAreas')
        && unchanged('assistantWrite');

      // Benutzer verwalten – freischalten, Rollen zuweisen, deaktivieren,
      // löschen – darf ausschliesslich der Administrator. Damit genügt ein
      // kompromittiertes Bischofschafts-Konto nicht mehr, um alle übrigen
      // Konten zu übernehmen oder auszusperren.
      allow update: if isAdmin();

      allow delete: if isAdmin();
    }

    /* ---------------- Zugriffsprotokoll ---------------- */

    /*
     * Wer war wann da, und was hat sich dabei geändert.
     *
     * Die Sammlung ist das Gegenstück zur Benutzerverwaltung darüber: Dort
     * wird Zugriff vergeben, hier steht, was daraus geworden ist. Lesen darf
     * sie deshalb dieselbe Stelle – das Administrator-Konto und sonst
     * niemand. Für die Bischofschaft wäre es die Anwesenheitsliste ihrer
     * Kolleginnen und Kollegen, und dafür gibt es keinen Anlass.
     *
     * Geschrieben wird aus dem Browser jedes Kontos, denn nur dort ist
     * bekannt, was gerade geschieht. Daraus folgen die beiden Bedingungen
     * unten: Ein Eintrag muss auf das schreibende Konto lauten (`uid` und
     * E-Mail aus dem Token), sonst könnte jemand eine fremde Spur legen.
     * Und einmal geschrieben, bleibt er stehen – `delete` hat allein der
     * Administrator, damit er alte Einträge wegräumen kann.
     *
     * Fortgeschrieben werden darf genau eine Sache: der laufende Besuch.
     * Er hält fest, wie lange jemand da war und wie viele Ansichten er
     * geöffnet hat, und beides steht erst am Ende fest. Ein
     * Änderungseintrag dagegen ist mit dem Schreiben fertig; `kind` bleibt
     * deshalb unverändert, sonst liesse sich eine Änderung nachträglich in
     * einen Besuch verwandeln und damit überschreiben.
     */
    match /accessLog/{entryId} {
      allow read: if isAdmin();

      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.kind in ['session', 'change'];

      allow update: if signedIn()
        && resource.data.kind == 'session'
        && resource.data.uid == request.auth.uid
        && unchanged('kind')
        && unchanged('uid')
        && unchanged('email')
        && unchanged('at');

      allow delete: if isAdmin();
    }

    /* ---------------- Sitzungen ---------------- */

    match /meetings/{meetingId} {
      allow read, write: if approved();
    }

    /* ---------------- Traktanden und Pendenzen ---------------- */

    match /agendaItems/{itemId} {
      // Ohne Abstufung, auch bei seelsorgerischen Anliegen: Die ganze
      // Bischofschaft arbeitet am selben Bestand. Das frühere Kennzeichen
      // «vertraulich» ist deshalb ganz weggefallen – es wurde gepflegt, ohne
      // je etwas zu bewirken.
      allow read, write: if approved();
    }

    /*
     * Die Aufgaben, die zur Leitung eines Monats gehören – die Vorlagen,
     * aus denen Monat für Monat eine Pendenz entsteht. Sie gehören der
     * ganzen Bischofschaft wie die Pendenzen selbst.
     */
    match /monthlyDuties/{dutyId} {
      allow read, write: if approved();
    }

    /* ---------------- Mitglieder ---------------- */

    /*
     * Das Mitgliederverzeichnis.
     *
     * Die Assistenz liest es: Ohne die Gemeinde liesse sich weder eine
     * Ansprache noch ein Gebet vergeben, und die Vorschlagslisten leben
     * davon. Schreiben darf sie genau das, was aus ihrer Arbeit entsteht –
     * wer wann zuletzt gesprochen hat und wer gerade nicht angefragt werden
     * soll. Name, Adresse, Notizen und alles Übrige bleiben unangetastet
     * (siehe `services/talks` und `services/prayers`).
     */
    match /members/{memberId} {
      allow read: if approved() || assistantAny();
      allow write: if approved();

      allow update: if (assistantWrites(['talks'])
          && touchedKeys().hasOnly([
               'availableForTalks', 'talkHoldUntil', 'talkAvailabilityChangedAt',
               'talkHold', 'lastTalkDate', 'talkCount', 'updatedAt'
             ]))
        || (assistantWrites(['prayers'])
          && touchedKeys().hasOnly([
               'availableForPrayers', 'prayerHoldUntil', 'prayerAvailabilityChangedAt',
               'updatedAt'
             ]));
    }

    /* ---------------- Ansprachen und Zeugnisse ---------------- */

    match /talks/{talkId} {
      allow read: if approved() || assistantSees(['talks']);
      allow write: if approved() || assistantWrites(['talks']);
    }

    /* ---------------- Abendmahlsversammlung ---------------- */

    /*
     * Die Sonntage – ein Dokument je Datum.
     *
     * Gelesen wird es von jeder Assistenz: Alle drei Bereiche brauchen die
     * Auskunft, was an diesem Sonntag stattfindet, und die Lieder stehen
     * ohnehin darin. Geschrieben wird feldweise – «Musik» rührt die Lieder
     * und die Musikeinlagen an, «Ansprachen» die Angaben zum Programm.
     * `announcements`, `business`, `notes`, der Vorsitz und die Begrüssungen
     * stehen im selben Dokument und bleiben unangetastet.
     *
     * `date` und `updatedAt` schreibt jeder Vorgang mit (siehe
     * `saveSacramentMeeting`) – sie stehen deshalb in beiden Listen.
     */
    match /sacramentMeetings/{dateKey} {
      allow read: if approved() || assistantAny();
      allow write: if approved();

      allow create, update: if (assistantWrites(['music'])
          && touchedKeys().hasOnly(['hymns', 'musicalNumbers', 'date', 'updatedAt']))
        || (assistantWrites(['talks'])
          && touchedKeys().hasOnly([
               'talkSlots', 'kind', 'kindLabel', 'meets', 'plansTalks', 'responsibleId',
               'date', 'updatedAt'
             ]));
    }

    match /prayers/{prayerId} {
      allow read: if approved() || assistantSees(['prayers']);
      allow write: if approved() || assistantWrites(['prayers']);
    }

    // Wiederkehrende Bekanntmachungen gelten für viele Sonntage zugleich.
    match /announcementSeries/{seriesId} {
      allow read, write: if approved();
    }

    /* ---------------- Putzplan ---------------- */

    match /cleaningWeeks/{weekId} {
      allow read, write: if approved();
    }

    /* ---------------- Gesangbuch ---------------- */

    // Die Liederliste liest auch die Assistenz «Musik» – ohne sie stünde im
    // Feld eine Nummer ohne Titel. Gepflegt wird sie über den Import und
    // damit vom Vollzugriff.
    match /hymns/{number} {
      allow read: if approved() || assistantAny();
      allow write: if approved();
    }

    /* ---------------- Berufungen ---------------- */

    match /callings/{callingId} {
      allow read, write: if approved();
    }

    /* ---------------- Notizen ---------------- */

    // Notizen gehören der ganzen Bischofschaft: Es gibt keine private Notiz,
    // deshalb auch keine Einschränkung auf die Person, die sie angelegt hat.
    match /notes/{noteId} {
      allow read, write: if approved();
    }

    /* ---------------- Aktivitäten AP ---------------- */

    /*
     * Der Aktivitätenplan der Priestertumskollegien – der einzige Bereich,
     * der ohne Anmeldung offensteht.
     *
     * `read: if true` ist hier keine vergessene Bedingung, sondern der
     * Zweck: Die Seite unter `/ap` ist das Anschlagbrett der AP's. Sie wird
     * den Jugendlichen, ihren Eltern und den Beratern als Link geschickt,
     * und ein Anschlagbrett, für das man sich anmelden muss, wird nicht
     * gelesen. Entschieden hat das die Bischofschaft; die Regel schreibt es
     * bloss auf.
     *
     * Was damit offensteht, ist genau das, was auch auf dem ausgedruckten
     * Plan stünde: Datum, Anlass, Treffpunkt, Zeit, Zuständigkeit, die
     * Bemerkung dazu – und welches Kollegium den Monat führt. Personendaten
     * im eigentlichen Sinn stehen in `members`, `callings`, `agendaItems`
     * und den übrigen Sammlungen, und die bleiben verschlossen. Wer einen
     * Termin erfasst, schreibt damit ins Schaufenster; das steht so auch im
     * README, damit es niemanden überrascht.
     *
     * Geändert wird der Plan weiterhin nur mit Rolle. Lesen ist offen,
     * schreiben nicht – und zwischen beidem liegt der ganze Unterschied.
     */
    match /apActivities/{activityId} {
      allow read: if true;
      allow write: if apWrite();
    }

    match /apMonths/{month} {
      allow read: if true;
      allow write: if apWrite();
    }

    /*
     * Die Links, unter denen der Plan als Kalender abonniert werden kann.
     *
     * Lesen darf sie jedes Konto, das den Plan sieht – auch `ap_viewer`;
     * ohne Anmeldung dagegen niemand, obwohl der Plan selbst offensteht.
     * Das ist kein Widerspruch, sondern der Unterschied zwischen einer
     * Seite und einer Berechtigung: Ein Feed-Link trägt sein Token, wer ihn
     * liest, kann ihn weitergeben, und widerrufen wird er einzeln. Eine
     * Liste dieser Links gehört deshalb nicht ins Schaufenster – wer den
     * Plan bloss lesen will, findet ihn unter `/ap`, dafür braucht er
     * keinen Link.
     *
     * Vergeben, widerrufen und löschen darf sie weiterhin nur, wer den Plan
     * auch pflegen darf. Wer bloss zusieht, kopiert einen bestehenden Link –
     * er legt keinen an und nimmt keinen weg.
     *
     * Ausgeliefert wird der Feed nicht von hier, sondern von der
     * Netlify-Function. Die arbeitet mit einem Dienstkonto und geht damit an
     * diesen Regeln vorbei; sie prüft dafür das Token – ein Kalenderprogramm
     * kann sich nirgends anmelden.
     */
    match /calendarFeeds/{feedId} {
      allow read: if apAccess();
      allow write: if apWrite();
    }

    /* ---------------- Impuls ---------------- */

    /*
     * Der geistige Bereich für die AP's (docs/KONZEPT-IMPULS.md) – nach dem
     * AP-Kalender die zweite Insel, die ohne Vollzugriff erreichbar ist.
     * Wer sie sieht, sagt der Schalter am Konto (`impulseAccess`); Inhalte
     * pflegt die Redaktion (`impulseWrite`).
     *
     * Lesen dürfen alle im Bereich den ganzen Bestand – Entwürfe und
     * kommende Wochen eingeschlossen. Das ist eine Abwägung und keine
     * Nachlässigkeit: Eine Zeile «nur Veröffentlichtes» zwänge jede
     * Abfrage auf einen gefilterten Ausschnitt und bräche den einfachen
     * Offline-Abgleich – und geschützt würde wenig, denn schon die
     * veröffentlichte Quizfrage trägt ihre Lösung im selben Dokument.
     * Wer mit Entwicklerwerkzeugen nachsieht, kann sich die Antwort also
     * ohnehin holen und betrügt dabei nur sich selbst: Gewertet wird die
     * Teilnahme, nicht die Richtigkeit. Was die AP's zu sehen bekommen,
     * entscheidet die Ansicht (`visibleImpulseItems` in lib/impulse).
     */
    match /impulseItems/{itemId} {
      allow read: if impulseAccess();
      allow write: if impulseWrite();
    }

    /*
     * Eine Antwort pro Person und Frage.
     *
     * Die Dokument-ID trägt beides – `{itemId}_{uid}` – und die Regel
     * prüft, dass beide Teile zur schreibenden Person passen: Niemand
     * antwortet für jemand anderen, und niemand antwortet zweimal
     * (die zweite Antwort wäre ein `update`, und das gibt es nicht:
     * ein Versuch, keine Korrektur). Lesen dürfen alle im Bereich –
     * die Auflösung und später das Gruppenbild leben davon.
     * Wegräumen kann allein die Redaktion, etwa Testantworten.
     */
    match /impulseAnswers/{answerId} {
      allow read: if impulseAccess();

      allow create: if impulseAccess()
        && answerId == request.resource.data.itemId + '_' + request.auth.uid
        && request.resource.data.uid == request.auth.uid;

      allow update: if false;

      allow delete: if impulseWrite();
    }

    /*
     * Der persönliche Fortschritt – Wochenziel und Tages-Challenge.
     *
     * Ein Dokument pro Konto, die UID ist die Dokument-ID. Geschrieben
     * wird es ausschliesslich von der Person selbst – Selbstauskunft
     * heisst auch: Niemand hakt für jemand anderen ab, und anders als
     * bei den Antworten darf umgehakt werden (ein Versehen beim Ziel ist
     * kein Quizversuch). Lesen dürfen alle im Bereich – die Gruppenleiste
     * «diese Woche dabei» lebt davon. Wegräumen kann die Redaktion.
     */
    match /impulseProgress/{userId} {
      allow read: if impulseAccess();

      allow create, update: if impulseAccess()
        && request.auth.uid == userId
        && request.resource.data.uid == userId;

      allow delete: if impulseWrite();
    }

    /*
     * Beiträge zur Frage der Woche.
     *
     * Eine Antwort pro Person und Frage – die Dokument-ID trägt beides,
     * wie bei den Quizantworten. Anders als dort darf die eigene
     * nachgebessert werden: Sie ist ein persönliches Wort, kein Versuch.
     * Was dabei tabu bleibt: Konto, Frage und das Moderations-Feld –
     * ausblenden und wieder zeigen kann allein die Redaktion, und ein
     * Beitrag kann nicht schon ausgeblendet zur Welt kommen, um der
     * Moderation zuvorzukommen. Dass die Antworten der anderen erst nach
     * der eigenen erscheinen, setzt die Ansicht durch – wer daran vorbei
     * liest, liest nur, was er nach einem ehrlichen Satz ohnehin sähe.
     */
    match /impulseComments/{commentId} {
      allow read: if impulseAccess();

      allow create: if impulseAccess()
        && commentId == request.resource.data.itemId + '_' + request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.hidden == false;

      allow update: if impulseWrite()
        || (impulseAccess()
          && resource.data.uid == request.auth.uid
          && unchanged('uid')
          && unchanged('itemId')
          && unchanged('hidden'));

      allow delete: if impulseWrite()
        || (impulseAccess() && resource.data.uid == request.auth.uid);
    }

    /*
     * Die Mitmach-Ecke: Einreichungen der AP's.
     *
     * Angelegt wird nur auf den eigenen Namen und nur als «offen» – die
     * Übernahme (`accepted`) spricht allein die Redaktion aus, und nur
     * sie darf fremde Einreichungen anfassen oder entfernen. Die eigene
     * lässt sich nachbessern und zurückziehen, solange der Zustand
     * unangetastet bleibt.
     *
     * Lesen dürfen alle im Bereich – dieselbe Abwägung wie bei den
     * Inhalten: Die Oberfläche zeigt eine Einreichung nur der Person
     * selbst und der Redaktion, und veröffentlicht wird sie erst, wenn
     * die Redaktion daraus einen Inhalt gemacht hat. Eine Leserregel je
     * Person zwänge jede Abfrage auf einen Ausschnitt und bräche den
     * einfachen Offline-Abgleich – geschützt würde wenig, denn die
     * Einreichung ist für die Gruppe gedacht.
     */
    match /impulseSubmissions/{submissionId} {
      allow read: if impulseAccess();

      allow create: if impulseAccess()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'open';

      allow update: if impulseWrite()
        || (impulseAccess()
          && resource.data.uid == request.auth.uid
          && unchanged('uid')
          && unchanged('status'));

      allow delete: if impulseWrite()
        || (impulseAccess() && resource.data.uid == request.auth.uid);
    }

    /* ---------------- Benachrichtigungen ---------------- */

    /*
     * Die Geräte-Adressen für Benachrichtigungen.
     *
     * Ein Dokument je Gerät, das Cloud-Messaging-Token ist die ID.
     * Hinterlegt und entfernt wird nur auf den eigenen Namen; gelesen
     * werden muss hier gar nichts – verschickt wird von der geplanten
     * Function über das Dienstkonto, und das geht an diesen Regeln
     * vorbei. Nachsehen und aufräumen darf der Administrator.
     */
    match /pushTokens/{tokenId} {
      allow read: if isAdmin();

      allow create, update: if notifyAccess()
        && request.resource.data.uid == request.auth.uid;

      allow delete: if isAdmin()
        || (notifyAccess() && resource.data.uid == request.auth.uid);
    }

    /*
     * Was jemand benachrichtigt bekommen will – ein Dokument je Konto,
     * die UID ist die ID.
     *
     * Nur die eigene Person liest und schreibt hier; niemand sonst hat
     * ein Interesse daran, und die Einstellung anderer geht keinen etwas
     * an. Die Felder, die der Versand selbst führt, sind gegen den
     * Client verriegelt: Wer sie zurückstellen könnte, könnte sich
     * dieselbe Nachricht beliebig oft schicken lassen – aus Versehen
     * oder aus Übermut.
     */
    match /notificationSettings/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;

      allow create: if notifyAccess()
        && request.auth.uid == userId
        && request.resource.data.uid == userId
        && !request.resource.data.keys()
             .hasAny(['impulsSentAt', 'agendaSentAt', 'meetingsNotified', 'apNotified']);

      allow update: if notifyAccess()
        && request.auth.uid == userId
        && request.resource.data.uid == userId
        && unchanged('impulsSentAt')
        && unchanged('agendaSentAt')
        && unchanged('meetingsNotified')
        && unchanged('apNotified');
    }

    /* ---------------- Einstellungen ---------------- */

    // Lesen darf auch, wer nur den AP-Kalender sieht: Der Name der Gemeinde
    // steht in der Kopfzeile. Ändern darf ihn nur der Vollzugriff.
    // Lesen darf auch die Assistenz: Dort stehen der Name der Gemeinde, die
    // Zeit der Versammlung, die Zahl der Ansprachenplätze – und das
    // Monatsthema. Ändern darf all das nur der Vollzugriff; damit ist das
    // Monatsthema für die Assistenz von selbst nur zum Lesen da.
    match /settings/{docId} {
      allow read: if apAccess() || assistantAny();
      allow write: if approved();
    }

    /* ---------------- Alles Übrige ---------------- */

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
