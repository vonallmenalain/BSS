rules_version = '2';

// Sicherheitsregeln für die Bischofschafts-App.
//
// Grundsatz: Die Datenbank enthält Personendaten einer Kirchengemeinde.
// Lesen darf nur, wer angemeldet UND von einem Leiter freigeschaltet wurde.
// Neue Konten starten mit der Rolle `pending` und sehen nichts.
//
// Rollen:
//   bishop     – Bischof, vollständiger Zugriff
//   counselor  – Ratgeber, wie Bischof (ausser Benutzer endgültig löschen)
//   secretary  – Sekretär, arbeitet mit, sieht keine vertraulichen Traktanden
//   pending    – wartet auf Freigabe, kein Datenzugriff

service cloud.firestore {
  match /databases/{database}/documents {

    /* ---------------- Hilfsfunktionen ---------------- */

    function signedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasProfile() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    // Freigeschaltet: Profil vorhanden, aktiv und mit echter Rolle.
    function approved() {
      return hasProfile()
        && userDoc().active == true
        && userDoc().role in ['bishop', 'counselor', 'secretary'];
    }

    function isLeadership() {
      return hasProfile()
        && userDoc().active == true
        && userDoc().role in ['bishop', 'counselor'];
    }

    function isBishop() {
      return hasProfile() && userDoc().active == true && userDoc().role == 'bishop';
    }

    /*
     * Prüft, dass ein Feld durch die Schreiboperation nicht verändert wird.
     *
     * `resource` ist null, wenn das Dokument noch nicht existiert. Firestore
     * wertet bei einem `set()` beide Pfade (create und update) aus, deshalb
     * muss dieser Fall abgefangen werden – sonst bricht die Auswertung mit
     * einem Fehler ab statt sauber `false` zu liefern.
     */
    function unchanged(field) {
      return resource != null
        && (!(field in request.resource.data)
            || request.resource.data[field] == resource.data[field]);
    }


    /* ---------------- Benutzer ---------------- */

    match /users/{userId} {
      // Jeder Angemeldete sieht sein eigenes Profil (um die Rolle zu erfahren),
      // Freigeschaltete sehen das ganze Team (für Zuweisungen und Namen).
      allow get: if signedIn() && (request.auth.uid == userId || approved());
      allow list: if approved();

      // Ein neues Konto legt sein eigenes Profil an – zwingend als `pending`.
      // Damit kann sich niemand selbst Rechte geben.
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.role == 'pending'
        && request.resource.data.active == true;

      // Eigene Angaben ändern, aber niemals Rolle oder Aktivstatus.
      allow update: if signedIn()
        && request.auth.uid == userId
        && unchanged('role')
        && unchanged('active');

      // Leiter vergeben Rollen und schalten Konten frei.
      allow update: if isLeadership();

      // Profile endgültig entfernen ist dem Bischof vorbehalten.
      allow delete: if isBishop();
    }

    /* ---------------- Sitzungen ---------------- */

    match /meetings/{meetingId} {
      allow read: if approved();
      allow create, update: if approved();
      allow delete: if isLeadership();
    }

    /* ---------------- Traktanden und Pendenzen ---------------- */

    match /agendaItems/{itemId} {
      // Vertrauliche Traktanden bleiben der Leitung vorbehalten.
      //
      // Wichtig: Auch `list` wird pro zurückgegebenem Dokument geprüft. Enthält
      // eine Abfrage ein Dokument, das die Bedingung verletzt, schlägt die
      // gesamte Abfrage fehl. Der Client hängt für Sekretäre deshalb
      // `where('confidential', '==', false)` an – siehe src/hooks/useFirestore.ts.
      // Der Vergleich muss genau so einfach bleiben: `resource.data.confidential
      // == false`. Nur dann kann Firestore ihn gegen den Filter der Abfrage
      // abgleichen und eine ungefilterte Abfrage von vornherein abweisen.
      // Umschreibungen mit `data.get('confidential', false)` sind für die
      // Auswertung undurchsichtig – dann laufen Abfragen durch und liefern
      // auch vertrauliche Dokumente aus. Nachgewiesen mit dem Regeltest.
      //
      // Fehlt das Feld, greift die Regel nicht: kein Zugriff. Das ist die
      // sichere Richtung, und die App setzt `confidential` beim Anlegen immer.
      allow get, list: if approved()
        && (isLeadership() || resource.data.confidential == false);

      allow create: if approved()
        && (isLeadership() || request.resource.data.confidential == false);

      // Sekretäre dürfen ein Traktandum weder als vertraulich markieren noch
      // ein bestehendes vertrauliches verändern.
      allow update: if approved() && resource != null
        && (isLeadership() || (resource.data.confidential == false
                               && request.resource.data.confidential == false));

      allow delete: if approved() && resource != null
        && (isLeadership() || resource.data.confidential == false);
    }

    /* ---------------- Mitglieder ---------------- */

    match /members/{memberId} {
      allow read: if approved();
      allow create, update: if approved();
      // Löschen verändert die Datenbasis dauerhaft – nur die Leitung.
      allow delete: if isLeadership();
    }

    /* ---------------- Ansprachen ---------------- */

    match /talks/{talkId} {
      allow read, create, update, delete: if approved();
    }

    /* ---------------- Berufungen ---------------- */

    match /callings/{callingId} {
      // Berufungen sind vertraulich, solange sie noch nicht bestätigt sind.
      // Der Einfachheit halber bleibt der ganze Bereich der Leitung und den
      // Sekretären vorbehalten – wie der Rest der App.
      allow read, create, update: if approved();
      allow delete: if isLeadership();
    }

    /* ---------------- Einstellungen ---------------- */

    match /settings/{docId} {
      allow read: if approved();
      allow write: if isLeadership();
    }

    /* ---------------- Alles Übrige ---------------- */

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
