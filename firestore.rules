rules_version = '2';

// Sicherheitsregeln für die Bischofschafts-App.
//
// Grundsatz: Die Datenbank enthält Personendaten einer Kirchengemeinde.
// Lesen darf nur, wer angemeldet UND freigeschaltet wurde. Neue Konten
// starten mit der Rolle `pending` und sehen nichts.
//
// Rollen:
//   bishop              – Bischof
//   counselor1          – 1. Ratgeber
//   counselor2          – 2. Ratgeber
//   executive_secretary – Exekutivsekretär
//   secretary           – Sekretär
//   counselor           – Sammelrolle früherer Versionen (weiterhin gültig)
//   ap_editor           – nur der AP-Kalender, mit Schreibrecht
//   ap_viewer           – nur der AP-Kalender, ausschliesslich lesend
//   pending             – wartet auf Freigabe, kein Datenzugriff
//
// Innerhalb der Bischofschaft beschreibt die Rolle die Aufgabe, nicht den
// Rechteumfang: Alle freigeschalteten Rollen arbeiten am selben Datenbestand
// und sehen alles. Die Liste unten muss mit `FULL_ACCESS_ROLES` in
// src/lib/types.ts übereinstimmen.
//
// Die beiden AP-Rollen sind die Ausnahme. Der Aktivitätenplan wird mit den
// Beratern und der Jugendführung geteilt; die haben keine Aufgabe, die
// Einblick in Personendaten rechtfertigt. Sie erreichen deshalb genau zwei
// Sammlungen – `apActivities` und `apMonths` – sowie lesend die
// Einstellungen (für den Namen der Gemeinde in der Kopfzeile). Alles
// Übrige bleibt ihnen verschlossen, und zwar hier und nicht erst in der
// Oberfläche.

service cloud.firestore {
  match /databases/{database}/documents {

    /* ---------------- Hilfsfunktionen ---------------- */

    function signedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasProfile() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    // Freigeschaltet: Profil vorhanden, aktiv und mit echter Rolle.
    // Wer das erfüllt, hat vollen Zugriff.
    function approved() {
      return hasProfile()
        && userDoc().active == true
        && userDoc().role in [
             'bishop', 'counselor1', 'counselor2',
             'executive_secretary', 'secretary', 'counselor'
           ];
    }

    // Darf den AP-Kalender lesen – Vollzugriff eingeschlossen.
    function apAccess() {
      return hasProfile()
        && userDoc().active == true
        && userDoc().role in [
             'bishop', 'counselor1', 'counselor2',
             'executive_secretary', 'secretary', 'counselor',
             'ap_editor', 'ap_viewer'
           ];
    }

    // Darf im AP-Kalender auch schreiben. `ap_viewer` fehlt hier bewusst.
    function apWrite() {
      return hasProfile()
        && userDoc().active == true
        && userDoc().role in [
             'bishop', 'counselor1', 'counselor2',
             'executive_secretary', 'secretary', 'counselor',
             'ap_editor'
           ];
    }

    /*
     * Prüft, dass ein Feld durch die Schreiboperation nicht verändert wird.
     *
     * `resource` ist null, wenn das Dokument noch nicht existiert. Firestore
     * wertet bei einem `set()` beide Pfade (create und update) aus, deshalb
     * muss dieser Fall abgefangen werden – sonst bricht die Auswertung mit
     * einem Fehler ab statt sauber `false` zu liefern.
     */
    function unchanged(field) {
      return resource != null
        && (!(field in request.resource.data)
            || request.resource.data[field] == resource.data[field]);
    }


    /* ---------------- Benutzer ---------------- */

    match /users/{userId} {
      // Jeder Angemeldete sieht sein eigenes Profil (um die Rolle zu erfahren),
      // Freigeschaltete sehen das ganze Team (für Zuweisungen und Namen).
      allow get: if signedIn() && (request.auth.uid == userId || approved());
      allow list: if approved();

      // Ein neues Konto legt sein eigenes Profil an – zwingend als `pending`.
      // Damit kann sich niemand selbst Rechte geben.
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.role == 'pending'
        && request.resource.data.active == true;

      // Wer noch nicht freigeschaltet ist, darf zwar seinen Namen pflegen,
      // aber weder Rolle noch Aktivstatus anfassen. Das ist die Sperre gegen
      // die Selbstfreischaltung.
      allow update: if signedIn()
        && request.auth.uid == userId
        && unchanged('role')
        && unchanged('active');

      // Freigeschaltete verwalten das Team – auch die eigene Rolle, damit
      // sich jede und jeder als 1. Ratgeber, Sekretär usw. eintragen kann.
      allow update: if approved();

      allow delete: if approved();
    }

    /* ---------------- Sitzungen ---------------- */

    match /meetings/{meetingId} {
      allow read, write: if approved();
    }

    /* ---------------- Traktanden und Pendenzen ---------------- */

    match /agendaItems/{itemId} {
      // Ohne Abstufung, auch bei seelsorgerischen Anliegen: Die ganze
      // Bischofschaft arbeitet am selben Bestand. Das frühere Kennzeichen
      // «vertraulich» ist deshalb ganz weggefallen – es wurde gepflegt, ohne
      // je etwas zu bewirken.
      allow read, write: if approved();
    }

    /* ---------------- Mitglieder ---------------- */

    match /members/{memberId} {
      allow read, write: if approved();
    }

    /* ---------------- Ansprachen und Zeugnisse ---------------- */

    match /talks/{talkId} {
      allow read, write: if approved();
    }

    /* ---------------- Abendmahlsversammlung ---------------- */

    match /sacramentMeetings/{dateKey} {
      allow read, write: if approved();
    }

    match /prayers/{prayerId} {
      allow read, write: if approved();
    }

    // Wiederkehrende Bekanntmachungen gelten für viele Sonntage zugleich.
    match /announcementSeries/{seriesId} {
      allow read, write: if approved();
    }

    /* ---------------- Putzplan ---------------- */

    match /cleaningWeeks/{weekId} {
      allow read, write: if approved();
    }

    /* ---------------- Gesangbuch ---------------- */

    match /hymns/{number} {
      allow read, write: if approved();
    }

    /* ---------------- Berufungen ---------------- */

    match /callings/{callingId} {
      allow read, write: if approved();
    }

    /* ---------------- Notizen ---------------- */

    // Notizen gehören der ganzen Bischofschaft: Es gibt keine private Notiz,
    // deshalb auch keine Einschränkung auf die Person, die sie angelegt hat.
    match /notes/{noteId} {
      allow read, write: if approved();
    }

    /* ---------------- Aktivitäten AP ---------------- */

    // Der Aktivitätenplan der Priestertumskollegien – der einzige Bereich,
    // den auch Konten ohne Vollzugriff erreichen.
    match /apActivities/{activityId} {
      allow read: if apAccess();
      allow write: if apWrite();
    }

    match /apMonths/{month} {
      allow read: if apAccess();
      allow write: if apWrite();
    }

    /* ---------------- Einstellungen ---------------- */

    // Lesen darf auch, wer nur den AP-Kalender sieht: Der Name der Gemeinde
    // steht in der Kopfzeile. Ändern darf ihn nur der Vollzugriff.
    match /settings/{docId} {
      allow read: if apAccess();
      allow write: if approved();
    }

    /* ---------------- Alles Übrige ---------------- */

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
