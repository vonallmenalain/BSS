# ---------------------------------------------------------------------------
# Firebase-Konfiguration
# ---------------------------------------------------------------------------
# Diese Werte findest du in der Firebase-Konsole:
#   Projekteinstellungen → Allgemein → Meine Apps → Web-App → SDK-Konfiguration
#
# Hinweis: Diese Schlüssel sind KEINE Geheimnisse. Sie identifizieren nur das
# Projekt und stehen in jeder ausgelieferten Web-App im Klartext. Der Schutz
# der Daten läuft über Firebase Authentication und die Sicherheitsregeln in
# firestore.rules.
#
# Lokal: Diese Datei nach `.env` kopieren und ausfüllen.
# Netlify: Unter «Site configuration → Environment variables» eintragen.
# ---------------------------------------------------------------------------

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=dein-projekt.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=dein-projekt
VITE_FIREBASE_STORAGE_BUCKET=dein-projekt.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ---------------------------------------------------------------------------
# Kalender-Abo (nur serverseitig)
# ---------------------------------------------------------------------------
# Damit der Aktivitätenplan als Kalender abonniert werden kann, liefert ihn
# eine Netlify-Function unter «/api/ap.ics» aus. Sie meldet sich mit einem
# Dienstkonto bei Firestore an – ein Kalenderprogramm kann sich nirgends
# anmelden und ruft nur eine Adresse ab.
#
# Dieser Wert ist – anders als alles oben – ein ECHTES GEHEIMNIS. Er gehört
# ausschliesslich in die Netlify-Umgebungsvariablen und niemals ins Repository
# oder in eine Datei, die mit ausgeliefert wird. Er trägt kein «VITE_» im
# Namen, und das ist Absicht: Nur so bleibt er aus dem Browser-Bundle heraus.
#
# So kommst du an den Wert:
#   Firebase-Konsole → Projekteinstellungen → Dienstkonten
#   → «Neuen privaten Schlüssel generieren» → die heruntergeladene
#   JSON-Datei vollständig als Wert einsetzen.
#
# Der Inhalt darf als JSON oder als Base64 davon hinterlegt werden. Base64
# hilft, wenn die Zeilenumbrüche im privaten Schlüssel unterwegs verloren
# gehen:  base64 -w0 dienstkonto.json
#
# Ohne diesen Wert läuft die App vollständig – nur die Kalender-Links
# antworten mit einer Fehlermeldung.
FIREBASE_SERVICE_ACCOUNT=

# Nur lokal: Gesetzt, spricht die Function mit dem Firestore-Emulator statt
# mit dem Produktivprojekt und braucht dann kein Dienstkonto. So lässt sich
# der Feed mit `npx netlify dev` ausprobieren. In Netlify NICHT eintragen.
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# ---------------------------------------------------------------------------
# Montags-Erinnerung im Bereich «Impuls» (Web-Push)
# ---------------------------------------------------------------------------
# Der ÖFFENTLICHE VAPID-Schlüssel aus der Firebase-Konsole:
#   Projekteinstellungen → Cloud Messaging → Web-Push-Zertifikate
#   → «Schlüsselpaar» (die lange Zeichenkette, beginnt meist mit «B»).
#
# Kein Geheimnis – er steht wie die übrigen VITE_-Werte im Browser-Bundle
# und dient nur dazu, dass ein Gerät sich für die Erinnerung anmelden kann.
# Der private Teil bleibt bei Firebase; versendet wird über die geplante
# Netlify-Function mit dem Dienstkonto (FIREBASE_SERVICE_ACCOUNT, oben).
#
# Nach dem Eintragen bei Netlify einmal neu ausrollen: VITE_-Werte werden
# beim Bauen eingesetzt, nicht zur Laufzeit.

VITE_FIREBASE_VAPID_KEY=
