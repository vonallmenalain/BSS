# --- Google Cloud Text-to-Speech ---
# API-Key mit Einschränkung auf "Cloud Text-to-Speech API"
GOOGLE_TTS_API_KEY=
# Optional: Projekt für Abrechnung/Quota (nötig bei Access-Token-Auth über gcloud)
GOOGLE_CLOUD_PROJECT=
# Optional: anderer (z.B. regionaler) Endpoint, falls in deinem Projekt verfügbar
GOOGLE_TTS_ENDPOINT=

# --- Offline-Vertonung mit Piper (optional) ---
# pip install piper-tts ; Modell z.B. de_DE-thorsten-high.onnx (+ .onnx.json daneben)
PIPER_MODEL=
PIPER_BIN=piper

# --- Rendering ---
# Eigener Chromium/Chrome-Headless-Shell (z.B. im Docker-Container); leer = Remotion lädt selbst
REMOTION_BROWSER_EXECUTABLE=
# Parallele Render-Tabs; Standard = Anzahl CPU-Kerne (max. 8)
RENDER_CONCURRENCY=
